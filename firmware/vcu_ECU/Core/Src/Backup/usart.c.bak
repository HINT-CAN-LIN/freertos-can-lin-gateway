/* USART2 configuration for the NUCLEO-F446RE ST-LINK virtual COM port.
 * The current Cube HAL bundle does not include the HAL UART module, so the
 * small byte-level driver is implemented in vcu_uart.c using USART registers.
 */
#include "main.h"
#include "vcu_uart.h"

void MX_USART2_UART_Init(void)
{
    GPIO_InitTypeDef gpio = {0};
    const uint32_t pclk1_hz = HAL_RCC_GetPCLK1Freq();

    if (pclk1_hz == 0U) {
        Error_Handler();
    }

    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_USART2_CLK_ENABLE();

    /* NUCLEO-F446RE default ST-LINK VCP: PA2=USART2_TX, PA3=USART2_RX. */
    gpio.Pin = GPIO_PIN_2 | GPIO_PIN_3;
    gpio.Mode = GPIO_MODE_AF_PP;
    gpio.Pull = GPIO_NOPULL;
    gpio.Speed = GPIO_SPEED_FREQ_VERY_HIGH;
    gpio.Alternate = GPIO_AF7_USART2;
    HAL_GPIO_Init(GPIOA, &gpio);

    USART2->CR1 = 0U;
    USART2->CR2 = 0U;
    USART2->CR3 = 0U;
    USART2->BRR = (pclk1_hz + (VCU_UART2_BAUDRATE / 2U)) /
                  VCU_UART2_BAUDRATE;
    USART2->CR1 = USART_CR1_UE | USART_CR1_TE | USART_CR1_RE;

    HAL_NVIC_SetPriority(USART2_IRQn, 6U, 0U);
    HAL_NVIC_ClearPendingIRQ(USART2_IRQn);
}
