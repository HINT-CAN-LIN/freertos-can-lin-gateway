VERSION "0.4 - review-ready interface proposal"

NS_ :
    NS_DESC_
    CM_
    BA_DEF_
    BA_
    VAL_
    BA_DEF_DEF_

BS_:

BU_: VCU MOTOR GATEWAY CLUSTER PC_TOOL

BO_ 256 VCU_Command: 8 VCU
 SG_ TorqueRequest : 0|16@1+ (0.1,0) [0|4000] "Nm" MOTOR,GATEWAY,CLUSTER
 SG_ Gear : 16|3@1+ (1,0) [0|3] "enum" MOTOR,GATEWAY,CLUSTER
 SG_ Brake : 19|1@1+ (1,0) [0|1] "bool" MOTOR,GATEWAY,CLUSTER
 SG_ AliveCounter : 20|4@1+ (1,0) [0|15] "count" MOTOR,GATEWAY,CLUSTER

BO_ 272 Motor_Status: 8 MOTOR
 SG_ RPM : 0|16@1+ (1,0) [0|12000] "rpm" VCU,GATEWAY,CLUSTER
 SG_ TorqueApplied : 16|16@1+ (0.1,0) [0|4000] "Nm" VCU,GATEWAY,CLUSTER
 SG_ MotorState : 32|2@1+ (1,0) [0|3] "state" VCU,GATEWAY,CLUSTER
 SG_ AliveCounter : 34|4@1+ (1,0) [0|15] "count" VCU,GATEWAY,CLUSTER

BO_ 288 Vehicle_Status: 8 GATEWAY
 SG_ Speed : 0|16@1+ (0.1,0) [0|250] "km/h" CLUSTER,PC_TOOL
 SG_ RPM : 16|16@1+ (1,0) [0|12000] "rpm" CLUSTER,PC_TOOL
 SG_ Gear : 32|3@1+ (1,0) [0|3] "enum" CLUSTER,PC_TOOL
 SG_ Brake : 35|1@1+ (1,0) [0|1] "bool" CLUSTER,PC_TOOL
 SG_ NetworkState : 36|2@1+ (1,0) [0|3] "state" CLUSTER,PC_TOOL

BO_ 512 Body_Status: 8 GATEWAY
 SG_ DoorStatus : 8|8@1+ (1,0) [0|3] "state" CLUSTER,PC_TOOL
 SG_ LightStatus : 16|8@1+ (1,0) [0|63] "bitmask" CLUSTER,PC_TOOL
 SG_ WindowStatus : 24|8@1+ (1,0) [0|5] "state" CLUSTER,PC_TOOL
 SG_ ReverseLamp : 0|1@1+ (1,0) [0|1] "bool" CLUSTER,PC_TOOL
 SG_ DoorOpen : 1|1@1+ (1,0) [0|1] "bool" CLUSTER,PC_TOOL

BO_ 768 Gateway_Status: 8 GATEWAY
 SG_ GatewayAlive : 0|4@1+ (1,0) [0|15] "count" VCU,MOTOR,CLUSTER,PC_TOOL
 SG_ QueueUsage : 8|8@1+ (1,0) [0|100] "%" VCU,MOTOR,CLUSTER,PC_TOOL

BO_ 784 Fault_Status: 8 GATEWAY
 SG_ FaultCode : 0|8@1+ (1,0) [0|6] "code" CLUSTER,PC_TOOL
 SG_ ECUOffline : 8|4@1+ (1,0) [0|7] "node" CLUSTER,PC_TOOL
 SG_ RecoveryState : 12|1@1+ (1,0) [0|1] "state" CLUSTER,PC_TOOL
 SG_ SystemState : 13|2@1+ (1,0) [0|3] "state" CLUSTER,PC_TOOL

CM_ "Source baseline: message definition workbook v0.3 + communication specification review. This v0.4 proposal resolves DBC-level inconsistencies only: Gear normal range 0..3, physical CAN receivers for Gateway_Status, duplicate Body_Status source consistency notes, and Fault_Status lifecycle semantics. LIN routing/schedule and event retry policy remain outside this CAN DBC. Interface Freeze requires counterpart-owner review.";
CM_ BO_ 256 "Source: CAN_Message_Definition row 6. Tx type: Cyclic. Age > 30 ms: VCU_TIMEOUT. Local fail-safe is implemented by the receiving ECU.";
CM_ BO_ 272 "Source: CAN_Message_Definition row 7. Tx type: Cyclic.";
CM_ BO_ 288 "Source: CAN_Message_Definition row 8. Tx type: Cyclic.";
CM_ BO_ 512 "Source: CAN_Message_Definition row 9. Tx type: Cyclic.";
CM_ BO_ 768 "Tx type: Cyclic, 100 ms. DBC receivers are actual CAN consumers only (VCU/MOTOR/CLUSTER/PC_TOOL). Door/Light/Window are LIN slaves; any logical propagation to them must be defined by LIN Matrix/Routing, not by CAN DBC Receiver.";
CM_ BO_ 784 "Tx type: Event. One Fault_Status frame represents one fault ACTIVE/CLEARED transition. Multiple simultaneous fault transitions are represented as separate events. Event ordering/retry/loss handling is a Fault Manager/Test policy and is not encoded by DBC.";
CM_ SG_ 256 TorqueRequest "Source: CAN_Signal_Definition row 6. Invalid raw: 0xFFFF (hex). Requirements: SYS_REQ_003, SYS_REQ_020.";
CM_ SG_ 256 Gear "Normal values: 0=P, 1=N, 2=D, 3=R. Raw 4..6 are RESERVED; raw 7 is INVALID. Normal physical range is therefore 0..3.";
CM_ SG_ 256 Brake "Source: CAN_Signal_Definition row 8. Invalid raw: N/A. Requirements: SYS_REQ_003.";
CM_ SG_ 256 AliveCounter "Source: CAN_Signal_Definition row 9. Invalid raw: N/A. Requirements: SYS_REQ_022-023. Valid counter 0..15, wraps 15 to 0. Expected next value = (previous + 1) modulo 16; sequence checking is application logic.";
CM_ SG_ 272 RPM "Source: CAN_Signal_Definition row 10. Invalid raw: 0xFFFF (hex). Requirements: SYS_REQ_004.";
CM_ SG_ 272 TorqueApplied "Source: CAN_Signal_Definition row 11. Invalid raw: 0xFFFF (hex). Requirements: SYS_REQ_004, SYS_REQ_024.";
CM_ SG_ 272 MotorState "Source: CAN_Signal_Definition row 12. Invalid raw: N/A. Requirements: SYS_REQ_004.";
CM_ SG_ 272 AliveCounter "Source: CAN_Signal_Definition row 13. Invalid raw: N/A. Requirements: SYS_REQ_022-023. Valid counter 0..15, wraps 15 to 0. Expected next value = (previous + 1) modulo 16; sequence checking is application logic.";
CM_ SG_ 288 Speed "Gateway-provided virtual vehicle speed. DBC defines encoding only (factor 0.1 km/h); RPM-to-Speed conversion model/coefficient belongs to Gateway/Virtual Motor application design.";
CM_ SG_ 288 RPM "Source: CAN_Signal_Definition row 15. Invalid raw: 0xFFFF (hex). Requirements: SYS_REQ_007.";
CM_ SG_ 288 Gear "Normal values: 0=P, 1=N, 2=D, 3=R. Raw 4..6 are RESERVED; raw 7 is INVALID. Normal physical range is therefore 0..3.";
CM_ SG_ 288 Brake "Source: CAN_Signal_Definition row 17. Invalid raw: N/A. Requirements: SYS_REQ_007.";
CM_ SG_ 288 NetworkState "Representative system health state: 0=NORMAL, 1=DEGRADED, 2=OFFLINE, 3=FAIL_SAFE. Used as the cyclic health summary.";
CM_ SG_ 512 DoorStatus "Source: CAN_Signal_Definition row 19. Invalid raw: 0xFF. Requirements: SYS_REQ_005, SYS_REQ_021.";
CM_ SG_ 512 LightStatus "Source: CAN_Signal_Definition row 20. Invalid raw: 0xFF. Requirements: SYS_REQ_006. Bitmask: 0x0=ALL_OFF, 0x1=HEAD_LAMP, 0x2=LEFT_TURN, 0x4=RIGHT_TURN, 0x8=HAZARD, 0x10=REVERSE_LAMP, 0x20=BRAKE_LAMP, 0xff=INVALID. Flags may be combined; no extra overlapping signals are introduced.";
CM_ SG_ 512 WindowStatus "Source: CAN_Signal_Definition row 21. Invalid raw: 0xFF. Requirements: SYS_REQ_042-044, SYS_REQ_057.";
CM_ SG_ 512 ReverseLamp "Derived from the same LIN Light_Status/LampState source used for Body_Status.LightStatus REVERSE_LAMP bit. Gateway routing shall update both consistently.";
CM_ SG_ 512 DoorOpen "Derived from the same LIN Door_Status source used to build Body_Status.DoorStatus. Gateway routing shall update both consistently.";
CM_ SG_ 768 GatewayAlive "Valid 4-bit cyclic counter 0..15 with wrap 15->0. No raw Invalid value is assigned; continuity/age checking is application logic.";
CM_ SG_ 768 QueueUsage "Source: CAN_Signal_Definition row 25. Invalid raw: 0xFF. Requirements: SYS_REQ_017, SYS_REQ_054.";
CM_ SG_ 784 FaultCode "Source: CAN_Signal_Definition row 26. Invalid raw: 0xFF. Requirements: SYS_REQ_018, SYS_REQ_025-026.";
CM_ SG_ 784 ECUOffline "Source: CAN_Signal_Definition row 27. Invalid raw: 0xF. Requirements: SYS_REQ_018, SYS_REQ_021, SYS_REQ_025.";
CM_ SG_ 784 RecoveryState "Compatibility name retained. Semantics are fault lifecycle state: 0=ACTIVE, 1=CLEARED. It does not encode an intermediate recovery-progress state.";
CM_ SG_ 784 SystemState "Representative system state copied from the same Gateway health aggregation used by Vehicle_Status.NetworkState for the instant of this fault event.";

BA_DEF_ "BusType" STRING ;
BA_DEF_ BO_ "GenMsgCycleTime" INT 0 65535;
BA_DEF_ BO_ "SourceTxType" STRING ;
