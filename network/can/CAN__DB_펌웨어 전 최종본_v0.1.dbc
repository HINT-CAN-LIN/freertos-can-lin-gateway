BA_ "GenSigStartValue" SG_ 512 ReverseLamp 0;
BA_ "GenSigStartValue" SG_ 512 DoorOpen 0;
BA_ "GenSigStartValue" SG_ 768 GatewayAlive 0;
BA_ "GenSigStartValue" SG_ 768 QueueUsage 0;
BA_ "GenSigInvalidValue" SG_ 768 QueueUsage 255;
BA_ "GenSigStartValue" SG_ 784 FaultCode 0;
